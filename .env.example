# Local development defaults only. Copy to .env before running Docker Compose.
APP_ENV=development

POSTGRES_DB=setucheck
POSTGRES_USER=setucheck
POSTGRES_PASSWORD=setucheck_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://setucheck:setucheck_dev_password@postgres:5432/setucheck
JWT_SECRET=change-this-development-secret-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_secret
MINIO_BUCKET=setucheck
MINIO_CONSOLE_PORT=9001
